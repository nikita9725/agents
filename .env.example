AGENT_PORT=8123
AGENT_TEST_PORT=18123

# OpenAI-compatible chat completions and function calling.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-name
LLM_API_KEY=replace-me
# DeepSeek: LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
LLM_EXTRA_BODY={}

# Optional tracing only; not required for startup or durable execution.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=etl-agent
# LANGSMITH_API_KEY=

# Host PostgreSQL connection; Compose API uses postgres:5432.
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=15432
TASK_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/etl_agent

# UTF-8 files available to read_local_file and text_search (relative to working directory).
TOOL_FILES_ROOT=examples/tool_data
